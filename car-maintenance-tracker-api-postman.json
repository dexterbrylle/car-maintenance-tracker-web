              ],
              "cookie": [],
              "body": "{\n  \"error\": {\n    \"code\": \"INVALID_CREDENTIALS\",\n    \"message\": \"Invalid credentials\",\n    \"details\": {}\n  },\n  \"timestamp\": \"2023-09-05T12:34:56.789Z\"\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Extract tokens from response and set environment variables",
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.tokens && response.tokens.access_token) {",
                  "        pm.environment.set(\"access_token\", response.tokens.access_token);",
                  "    }",
                  "    if (response.tokens && response.tokens.refresh_token) {",
                  "        pm.environment.set(\"refresh_token\", response.tokens.refresh_token);",
                  "    }",
                  "    if (response.user && response.user._id) {",
                  "        pm.environment.set(\"user_id\", response.user._id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
